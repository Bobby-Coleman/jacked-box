{
  "appId": "com.riffraff.party",
  "appName": "RiffRaff",
  "webDir": "dist",
  "backgroundColor": "#d9a466",
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#d9a466",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
