# RiffRaff build configuration. Copy to `.env` (local builds) or add these as GitHub
# Actions variables (Settings -> Secrets and variables -> Actions -> Variables) for the
# website and app builds. These are all PUBLISHABLE values: safe to ship inside the app.
# Never put secret keys here (ElevenLabs key, Supabase service_role key, webhook secrets).

# Public website (invite links from the native apps point here)
VITE_PUBLIC_URL=https://bobby-coleman.github.io/jacked-box/
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_URL=

# Accounts: Supabase project URL and anon (public) key, from Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Turn on after enabling each provider in Supabase -> Authentication -> Providers
VITE_AUTH_APPLE=false
VITE_AUTH_GOOGLE=false
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Subscriptions: RevenueCat public SDK keys (Project -> API keys)
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Store pages (shown on the website's Premium screen once the apps are live)
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Host voice for typed answers in Premium rooms (needs the `tts` edge function deployed)
VITE_LIVE_VOICE=false

# Beta: unlock Premium games for everyone (e.g. before the stores are set up)
VITE_EARLY_ACCESS=false
