{
  "name": "jacked-box-tools",
  "private": true,
  "type": "module",
  "description": "Offline asset tools: voice rendering (Chatterbox-Turbo via tools/tts, MIT) and icon rendering. Not needed to run or build the game.",
  "scripts": {
    "voice": "node gen-voice.mjs all",
    "voice:jobs": "node gen-voice.mjs jobs",
    "voice:encode": "node gen-voice.mjs encode",
    "voice:refs": "node tts/make-refs.mjs",
    "icons": "node make-icons.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "kokoro-js": "^1.2.1",
    "sharp": "^0.35.5"
  }
}
